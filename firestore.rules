rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 사용자 프로필 (닉네임). 본인 문서만 쓸 수 있고, 닉네임 조회를 위해 로그인한
    // 사람은 누구나 읽을 수 있다.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      // 채팅방 멤버만 읽을 수 있다.
      // (아직 생성되지 않은 문서를 getDoc()으로 조회할 때는 resource가 null이라
      //  resource.data 접근 자체가 규칙 평가 오류를 일으킨다 — "없으면 만들기" 흐름을
      //  위해 존재하지 않는 문서 조회는 항상 허용해야 한다. 실제 데이터 보호는
      //  문서가 존재할 때의 멤버십 체크로 충분하다.)
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.memberUids);

      // 새 채팅방은 자기 자신을 멤버에 포함해서 만든 경우만 허용.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;

      // 기존 멤버는 자유롭게 수정 가능. 비멤버는 "자기 자신을 멤버 목록에 추가"하는
      // 것만 허용 (밥매칭 그룹채팅에 새로 참여하는 경우).
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids)
        )
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;

        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
