# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SEOUL_BUS_SERVICE_KEY: data.go.kr "서울특별시_버스도착정보조회 서비스" 일반 인증키(Encoding).
# https://www.data.go.kr 마이페이지 > 데이터활용 > Open API > 활용신청 현황에서 발급.
# 클라이언트(BusTracker)에서 사용하므로 반드시 VITE_ 접두사가 필요하다.
VITE_SEOUL_BUS_SERVICE_KEY="MY_SEOUL_BUS_SERVICE_KEY"

# Firebase 프로젝트 설정 (실시간 채팅). Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱에서 확인.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project"
VITE_FIREBASE_STORAGE_BUCKET="my-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"

# 카카오맵 JavaScript SDK 앱 키. https://developers.kakao.com 콘솔 > 앱 설정 > 플랫폼 키에서 발급.
# 발급 후 같은 화면의 "JavaScript SDK 도메인"에 실행 중인 도메인(예: http://localhost:3000)을 등록해야 한다.
VITE_KAKAO_MAP_APP_KEY="MY_KAKAO_MAP_APP_KEY"

# 관리자 전용 로그인 이메일. 회원가입은 누구나 가능하지만,
# 로그인한 계정의 이메일이 이 값과 일치할 때만 "신고/공지 관리" 기능에 접근할 수 있다.
VITE_ADMIN_EMAIL="admin@example.com"
